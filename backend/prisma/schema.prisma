generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
} 

enum UserRole {
  USER
  ADMIN
}
enum InterviewType {
  DSA
  BEHAVIORAL
  SYSTEM_DESIGN
  CASE_STUDY
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

// Records *why* a given question was asked, so the interview engine's
// decision (follow up vs. simplify vs. move to a new topic) is explicit
// and auditable instead of being re-guessed from scratch every turn.
enum QuestionStrategy {
  OPENING
  FOLLOW_UP
  NEW_TOPIC
  SIMPLIFY
}

enum Role {
  USER
  AI
}

enum EmbeddingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  password     String?
  googleId     String?      @unique
  profileImage String?
  authProvider AuthProvider @default(GOOGLE)

  role      UserRole @default(USER)
  isActive  Boolean  @default(true)

  sessions  InterviewSession[]
  resumes   Resume[]
  resumeChunks ResumeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewSession {
  id           String            @id @default(cuid())
  title        String
  type         InterviewType
  difficulty   InterviewDifficulty @default(MEDIUM)
  durationMinutes Int            @default(30)
  status       InterviewStatus   @default(IN_PROGRESS)
  questions InterviewQuestion[]
  overallScore Float?
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId     String?
  resume       Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  messages     Message[]
  feedback     Feedback?

  // Session-level interview-engine state. Kept intentionally small:
  // just enough to stop repeats and detect struggle streaks without
  // re-parsing the full question history on every turn.
  coveredTopics        String[] @default([])
  consecutiveStruggles Int      @default(0)

  // Optional job description to tailor question generation toward a
  // specific role instead of only the resume + interview type/difficulty.
  jobDescription       String?  @db.Text

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Message {
  id         String   @id @default(cuid())

  role       Role

  content    String   @db.Text

  tokenCount Int?

  createdAt  DateTime @default(now())

  sessionId  String
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Resume {
  id               String            @id @default(cuid())

  originalName     String

  mimeType         String

  fileUrl          String

  extractedText    String?           @db.Text

  embeddingStatus  EmbeddingStatus   @default(PENDING)

  uploadedAt       DateTime          @default(now())

  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessions         InterviewSession[]
  chunks           ResumeChunk[]

  @@index([userId])

}

// Replaces the former ChromaDB "resume_chunks" collection.
// Embeddings are stored in Postgres using the pgvector extension and
// similarity search runs as a native SQL ORDER BY ... <=> ... query (see
// src/rag/retriever.ts) instead of pulling every row into Node and
// scoring in a JS loop.
//
// `embedding` is intentionally declared Unsupported — Prisma Client has
// no native vector type, so all reads/writes to this column go through
// $queryRaw/$executeRaw (see src/rag/vectorStore.ts and retriever.ts).
model ResumeChunk {
  id        String   @id @default(cuid())

  content   String   @db.Text

  embedding Unsupported("vector(768)")?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chunks are now scoped to the specific resume they came from — the
  // previous userId-only scoping meant a user with multiple resumes got
  // RAG context blended across all of them regardless of which resume an
  // interview session/chat was actually using. Cascades so deleting a
  // resume also deletes its chunks (previously they were orphaned).
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resumeId])
}

model Feedback {
  id                  String   @id @default(cuid())

  strengths           String   @db.Text

  weaknesses          String   @db.Text

  suggestions         String   @db.Text

  communicationScore  Float

  technicalScore      Float

  overallScore        Float

  sessionId           String   @unique

  session             InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InterviewQuestion {
  id             String   @id @default(cuid())
  questionNumber Int
  question       String
  answer         String?

  // Which concept this question targets, and why it was chosen
  // (opening question / follow-up / new topic / simplified retry).
  // Nullable so existing rows created before this migration remain valid.
  topic    String?
  strategy QuestionStrategy?

  evaluation QuestionEvaluation?
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model QuestionEvaluation {
  id                 String   @id @default(cuid())

  technicalScore     Int
  communicationScore Int
  confidenceScore    Int

 strengths String[] @default([])
weaknesses String[] @default([])
  feedback           String   @db.Text

  // True when the candidate's answer was a non-answer, "I don't know",
  // off-topic, or otherwise showed no real engagement with the question —
  // set by the AI evaluation itself rather than inferred with string matching.
  isWeakAnswer       Boolean  @default(false)

  questionId         String   @unique
  question           InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
}
